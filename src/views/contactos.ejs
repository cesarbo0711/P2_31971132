<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registros de Contactos</title>
    <link rel="stylesheet" href="/css/table.css">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500&display=swap" rel="stylesheet">
</head>
<body>
    <div class="contacts-container">
        <div class="contacts-header">
            <h1 class="contacts-title">Registros de Contacto</h1>
            <span>Total: <%= contacts.length %></span>
        </div>

        <% if (contacts.length > 0) { %>
            <table class="contacts-table">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Email</th>
                        <th>Comentario</th>
                        <th>IP</th>
                        <th>Fecha</th>
                    </tr>
                </thead>
                <tbody>
                    <% contacts.forEach(contact => { %>
                        <tr>
                            <td data-label="Nombre"><%= contact.nombre %></td>
                            <td data-label="Email" class="contact-email"><%= contact.email %></td>
                            <td data-label="Comentario"><%= contact.comentario %></td>
                            <td data-label="IP" class="contact-ip"><%= contact.ip %></td>
                            <td data-label="Fecha" class="contact-date">
                                <%= new Date(contact.createdAt).toLocaleDateString() %>
                                <br>
                                <%= new Date(contact.createdAt).toLocaleTimeString() %>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        <% } else { %>
            <p>No hay registros de contactos disponibles.</p>
        <% } %>
    </div>

    <div class="text-boxpi3">
<div class="container">
        <h2>Geolocalización por IP      : </h2>
        <p>Obteniendo tu ubicación...</p>
        <div id="location-info" style="display: none;">
            <h2>Información de Ubicación</h2>
            <p class="info-item"><strong>IP:</strong> <span id="ip"></span></p>
            <p class="info-item"><strong>País:</strong> <span id="country"></span></p>
            <p class="info-item"><strong>Código de País:</strong> <span id="countryCode"></span></p>
            <p class="info-item"><strong>Región:</strong> <span id="regionName"></span></p>
            <p class="info-item"><strong>Ciudad:</strong> <span id="city"></span></p>
            <p class="info-item"><strong>Latitud:</strong> <span id="latitude"></span></p>
            <p class="info-item"><strong>Longitud:</strong> <span id="longitude"></span></p>
            <p class="info-item"><strong>Zona Horaria:</strong> <span id="timezone"></span></p>
            <p class="info-item"><strong>Código Postal:</strong> <span id="zip"></span></p>
        </div>
        <div id="error-container" class="error-message" style="display: none;"></div>
    </div>

    <script>
        function obtenerGeolocalizacionPorIP() {
            fetch('http://ip-api.com/json') // La API gratuita de ip-api.com
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    return response.json();
                })
                .then(data => {
                    console.log('Datos de geolocalización:', data);
                    if (data.status === 'success') {
                        document.getElementById('location-info').style.display = 'block';
                        document.querySelector('.container > p').style.display = 'none'; // Ocultar "Obteniendo tu ubicación..."
                        document.getElementById('ip').textContent = data.query;
                        document.getElementById('country').textContent = data.country;
                        document.getElementById('countryCode').textContent = data.countryCode;
                        document.getElementById('regionName').textContent = data.regionName;
                        document.getElementById('city').textContent = data.city;
                        document.getElementById('latitude').textContent = data.lat;
                        document.getElementById('longitude').textContent = data.lon;
                        document.getElementById('timezone').textContent = data.timezone;
                        document.getElementById('zip').textContent = data.zip;
                        document.getElementById('error-container').style.display = 'none';


                    } else {
                        document.getElementById('error-container').textContent = `Error al obtener la geolocalización: ${data.message}`;
                        document.getElementById('error-container').style.display = 'block';
                        document.querySelector('.container > p').textContent = 'Error al obtener la ubicación.';
                        document.getElementById('location-info').style.display = 'none';
                    }
                })
                .catch(error => {
                    console.error('Error en la petición:', error);
                    document.getElementById('error-container').textContent = 'Ocurrió un error al intentar obtener la ubicación.';
                    document.getElementById('error-container').style.display = 'block';
                    document.querySelector('.container > p').textContent = 'Error al obtener la ubicación.';
                    document.getElementById('location-info').style.display = 'none';
                });
        }

        
        // Llamar a la función cuando la página se carga
        window.onload = obtenerGeolocalizacionPorIP;
</script>

</body>
</html>